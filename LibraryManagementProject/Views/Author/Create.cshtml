@model AuthorViewModel

<style>
    .fener-form-container {
        max-width: 600px;
        margin: 40px auto;
        padding: 0 20px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    }
    .card-fener {
        background-color: #fff;
        border-radius: 10px;
        border: 2px solid #0E2240; /* Lacivert kenar */
        padding: 20px;
    }
    label {
        font-weight: 600;
        color: #0E2240;
    }
    .form-control {
        border-radius: 8px;
        margin-bottom: 15px;
    }
    .btn-fener {
        background-color: #0E2240;
        color: #FFDD00;
        border: 2px solid #0E2240;
        border-radius: 20px;
        font-weight: 600;
        transition: background-color 0.2s, transform 0.2s;
        padding: 8px 20px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .btn-fener:hover {
        background-color: #FFDD00;
        color: #0E2240;
        transform: translateY(-2px);
        text-decoration: none;
    }
</style>

<div class="fener-form-container">
    <div class="card-fener">
        <h2 class="mb-3" style="color:#0E2240;">Add New Author</h2>
        <form method="post">
            <div class="mb-2">
                <label asp-for="FirstName"></label>
                <input asp-for="FirstName" class="form-control" />
            </div>
            <div class="mb-2">
                <label asp-for="LastName"></label>
                <input asp-for="LastName" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="DateOfBirth"></label>
                <input asp-for="DateOfBirth" type="date" class="form-control" />
            </div>
            <button type="submit" class="btn-fener">
                Save
            </button>
        </form>
    </div>
</div>

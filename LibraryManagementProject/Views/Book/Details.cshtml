@model BookViewModel

<style>
    .details-container {
        max-width: 600px;
        margin: 40px auto;
        padding: 20px;
        background-color: #fff;
        border: 2px solid #0E2240;
        border-radius: 10px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    }
    .details-container h2 {
        color: #0E2240;
        margin-bottom: 20px;
        text-align: center;
    }
    .details-item {
        margin-bottom: 10px;
        color: #333;
    }
    .btn-fener {
        background-color: #0E2240;
        color: #FFDD00;
        border: 2px solid #0E2240;
        border-radius: 20px;
        font-weight: 600;
        transition: background-color 0.2s, transform 0.2s;
        padding: 8px 20px;
        text-decoration: none;
    }
    .btn-fener:hover {
        background-color: #FFDD00;
        color: #0E2240;
        transform: translateY(-2px);
    }
</style>

<div class="details-container">
    <h2>Book Details</h2>
    <div class="details-item"><strong>Title:</strong> @Model.Title</div>
    <div class="details-item"><strong>Genre:</strong> @Model.Genre</div>
    <div class="details-item"><strong>ISBN:</strong> @Model.ISBN</div>
    <div class="details-item"><strong>Publish Date:</strong> @Model.PublishDate.ToShortDateString()</div>
    <div class="details-item"><strong>Copies Available:</strong> @Model.CopiesAvailable</div>
    <!-- Diğer alanlar -->

    <a asp-controller="Book" asp-action="List" class="btn-fener mt-3">Back to List</a>
</div>

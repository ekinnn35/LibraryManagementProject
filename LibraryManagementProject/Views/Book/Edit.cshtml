@model BookViewModel

<div class="fener-form-container">
    <h2>Edit Book</h2>
    <form method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-2">
            <label asp-for="Title"></label>
            <input asp-for="Title" class="form-control" />
        </div>
        <div class="mb-2">
            <label asp-for="Genre"></label>
            <input asp-for="Genre" class="form-control" />
        </div>
        <div class="mb-2">
            <label asp-for="ISBN"></label>
            <input asp-for="ISBN" class="form-control" />
        </div>
        <div class="mb-2">
            <label asp-for="PublishDate"></label>
            <input asp-for="PublishDate" type="date" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="CopiesAvailable"></label>
            <input asp-for="CopiesAvailable" type="number" class="form-control" />
        </div>
        <button type="submit" class="btn-fener">Update</button>
    </form>
</div>